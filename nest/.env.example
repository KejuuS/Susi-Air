# Port the API listens on. Render and Railway set this automatically.
PORT=3001

# The single "today" used by all business logic (YYYY-MM-DD).
APP_TODAY=2026-05-15

# Use a long random string in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN_SECONDS=3600

# The one hardcoded pilot account.
AUTH_USERNAME=johndoe
AUTH_PASSWORD=susiairtest

# Allowed frontend origins, comma-separated, no trailing slash.
CORS_ORIGIN=http://localhost:3000
